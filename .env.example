# Server
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chedi_csa

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=2592000

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=4
# Set true only for local tests without SMTP. Leave false for real email OTPs.
ALLOW_DEMO_OTP=false
# DEMO_OTP=1234

# Gmail SMTP (Google App Password — required for real OTP emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# Optional: log OTP send events (never includes the code)
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_URL=

# Optional Redis (OTP / rate-limit). Falls back to Mongo when unset.
# REDIS_URL=redis://127.0.0.1:6379

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*

# Membership
ADMIN_API_KEY=chedi-admin-demo
MEMBERSHIP_FEE_INR=500
DELIVERY_CHARGE_INR=10000
